# 颜色分割结果消息
std_msgs/Header header

# 检测到的颜色名称
string color_name

# 质心坐标 (像素坐标系)
geometry_msgs/Point centroid

# 四个角点的平均位置 (像素坐标系)
geometry_msgs/Point corner_average

# 四个角点 (按顺序: top-left, top-right, bottom-right, bottom-left)
geometry_msgs/Point[4] corners

# 区域面积 (像素)
float32 area

# 置信度 (0.0-1.0)
float32 confidence

# 相机信息
sensor_msgs/CameraInfo camera_info

