<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>top_cam_loop_state</name>
  <version>0.1.0</version>
  <description>
    Top camera loop state detection node.
    Detects parachute loops via YOLO, classifies each as fully/partial/not,
    assigns position-based IDs (R1, R2, L1, L2 ...) and publishes via ROS 2.
  </description>
  <maintainer email="todo@wpi.edu">MQP Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>parachute_interfaces</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
